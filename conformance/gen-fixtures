#
# Regenerates the conformance fixtures from corpus.txt.
#
# Usage: gen-fixtures [DUMPER [ARG...]]
#
# DUMPER is any command that accepts the flags --dump WORD,
# --complete PREFIX and --suggest WORD on its command line and prints
# the result on stdout. With no DUMPER it defaults to onym-dump, the
# conformance dumper built from the engine here, pointed at the pinned
# WordNet base prepared from the onym-data submodule. Output goes to
# fixtures/ next to this script unless ONYM_FIXTURES_DIR overrides it;
# run-conformance uses that override to regenerate into a temporary
# directory.
#
# The output is deterministic: it depends only on the dumper, the
# corpus and the fixed prefix and suggestion lists below. The script
# writes no timestamps.

set -eu

here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)

if [ "$#" -eq 0 ]; then
  # onym-dump is the owned generator of these fixtures, built from the
  # engine here. The engine takes an explicit data dir, so materialise
  # the pinned base from the onym-data submodule (base-only, since these
  # fixtures are overlay-free) and pass it. Prefer a release build, then
  # debug, then onym-dump on PATH.
  data="$here/../onym-data/build/wordnet-base"
  if [ -x "$here/../onym-data/prepare.sh" ]; then
    [ -f "$data/index.noun" ] || "$here/../onym-data/prepare.sh" --base-only "$data" >/dev/null
  fi
  for cand in \
    "$here/../target/release/onym-dump" \
    "$here/../target/debug/onym-dump"; do
    if [ -x "$cand" ]; then
      set -- "$cand" --data "$data"
      break
    fi
  done
  [ "$#" -eq 0 ] && set -- onym-dump --data "$data"
fi

out=${ONYM_FIXTURES_DIR:-"$here/fixtures"}

# Start from a clean slate so that words removed from the corpus do not
# leave stale fixtures behind.
rm -rf "$out"
mkdir -p "$out/dump" "$out/complete" "$out/suggest"

# Dump every corpus word. The fixture file name is the query form of
# the word: spaces become underscores.
while IFS= read -r word; do
  case $word in
    ''|'#'*) continue ;;
  esac
  name=$(printf '%s' "$word" | tr ' ' '_')
  "$@" --dump "$word" > "$out/dump/$name.txt"
done < "$here/corpus.txt"

# Completion fixtures for a small fixed prefix list, covering multiword
# prefixes, an exact headword, and a prefix with no matches. Keep this
# list in step with the engines' fixture tooling.
for prefix in ser ice run bea sh fel anti 'ice cr' dog zz; do
  name=$(printf '%s' "$prefix" | tr ' ' '_')
  "$@" --complete "$prefix" > "$out/complete/$name.txt"
done

# Suggestion fixtures for a fixed list of misspellings.
for word in wrod recieve beutiful hapy runnin hte dogg; do
  "$@" --suggest "$word" > "$out/suggest/$word.txt"
done
