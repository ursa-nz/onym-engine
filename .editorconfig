root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.rs]
indent_size = 4
max_line_length = 100

# The corpus and fixtures are frozen ISO-8859-1 bytes; editors must not reshape them.
[conformance/{corpus.txt,fixtures/**}]
charset = latin1
trim_trailing_whitespace = false
insert_final_newline = false
